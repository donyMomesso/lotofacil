+async function ensureMetodosConferenciaTable(env) {
+  await env.DB.prepare(`
+    CREATE TABLE IF NOT EXISTS jogos_sistema_conferencia (
+      id INTEGER PRIMARY KEY AUTOINCREMENT,
+      concurso INTEGER NOT NULL,
+      metodo TEXT NOT NULL,
+      dezenas_jogo TEXT NOT NULL,
+      dezenas_sorteadas TEXT NOT NULL,
+      acertos INTEGER NOT NULL,
+      conferido_em TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
+      UNIQUE(concurso, metodo)
+    )
+  `).run();
+  await env.DB.prepare(`
+    CREATE INDEX IF NOT EXISTS idx_jsc_concurso
+    ON jogos_sistema_conferencia (concurso DESC)
+  `).run();
+}
+
+function countHits(jogoDezenas, sorteadas) {
+  const set = new Set((sorteadas || []).map(Number));
+  return (jogoDezenas || []).map(Number).filter((n) => set.has(n)).length;
+}
+
+async function conferirJogosSistema(env) {
+  await ensureMetodosConferenciaTable(env);
+  const pending = await env.DB.prepare(`
+    SELECT js.concurso, js.metodo, js.dezenas, js.dezenas_texto, r.dezenas AS dezenas_sorteadas, r.data_sorteio
+    FROM jogos_sistema js
+    JOIN resultados r ON r.concurso = js.concurso
+    LEFT JOIN jogos_sistema_conferencia c
+      ON c.concurso = js.concurso AND c.metodo = js.metodo
+    WHERE c.id IS NULL
+    ORDER BY js.concurso ASC
+    LIMIT 500
+  `).all();
+  let inserted = 0;
+  for (const row of pending.results || []) {
+    const jogo = parseJson(row.dezenas, []);
+    const sorteadas = parseJson(row.dezenas_sorteadas, []);
+    if (!Array.isArray(jogo) || jogo.length !== 15 || !Array.isArray(sorteadas) || sorteadas.length !== 15) continue;
+    const acertos = countHits(jogo, sorteadas);
+    const res = await env.DB.prepare(`
+      INSERT OR IGNORE INTO jogos_sistema_conferencia
+        (concurso, metodo, dezenas_jogo, dezenas_sorteadas, acertos)
+      VALUES (?, ?, ?, ?, ?)
+    `).bind(
+      Number(row.concurso),
+      String(row.metodo),
+      JSON.stringify(jogo),
+      JSON.stringify(sorteadas),
+      acertos
+    ).run();
+    if (res.meta?.changes) inserted += 1;
+  }
+  return { inserted, pending: (pending.results || []).length };
+}
+
+function summarizeMetodoStats(rows, window) {
+  const byContest = new Map();
+  for (const row of rows) {
+    const c = Number(row.concurso);
+    if (!byContest.has(c)) byContest.set(c, []);
+    byContest.get(c).push(row);
+  }
+  const contests = [...byContest.keys()].sort((a, b) => a - b);
+  const use = window ? contests.slice(-window) : contests;
+  const useSet = new Set(use);
+  const byMethod = new Map();
+  for (const row of rows) {
+    if (!useSet.has(Number(row.concurso))) continue;
+    const m = row.metodo;
+    if (!byMethod.has(m)) byMethod.set(m, []);
+    byMethod.get(m).push(Number(row.acertos));
+  }
+  const metodos = [...byMethod.keys()].sort().map((metodo) => {
+    const vals = byMethod.get(metodo);
+    const n = vals.length;
+    const media = n ? vals.reduce((s, v) => s + v, 0) / n : 0;
+    const g11 = n ? vals.filter((v) => v >= 11).length / n : 0;
+    const g12 = n ? vals.filter((v) => v >= 12).length / n : 0;
+    return {
+      metodo,
+      n,
+      media_acertos: Learning.round(media, 4),
+      min: n ? Math.min(...vals) : null,
+      max: n ? Math.max(...vals) : null,
+      pct_11_mais: Learning.round(g11 * 100, 2),
+      pct_12_mais: Learning.round(g12 * 100, 2)
+    };
+  });
+  const all = metodos.flatMap((m) => byMethod.get(m.metodo));
+  return {
+    window: window || 'all',
+    contests: use.length,
+    firstContest: use[0] || null,
+    lastContest: use[use.length - 1] || null,
+    esperanca_teorica: 9,
+    metodos,
+    media_geral: all.length ? Learning.round(all.reduce((s, v) => s + v, 0) / all.length, 4) : null
+  };
+}
+
+async function metodosEstatisticasApi(env, url) {
+  await ensureMetodosConferenciaTable(env);
+  const sync = await conferirJogosSistema(env);
+  const rows = await env.DB.prepare(`
+    SELECT concurso, metodo, acertos, dezenas_jogo, dezenas_sorteadas, conferido_em
+    FROM jogos_sistema_conferencia
+    ORDER BY concurso DESC, metodo ASC
+    LIMIT 2000
+  `).all();
+  const list = rows.results || [];
+  return json({
+    ok: true,
+    purpose: 'metodos_m1_m9_hits_only',
+    sync,
+    total_registros: list.length,
+    janelas: {
+      ultimos_20: summarizeMetodoStats(list, 20),
+      ultimos_50: summarizeMetodoStats(list, 50),
+      completo: summarizeMetodoStats(list, null)
+    },
+    recent: list.slice(0, 45)
+  });
+}
